# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# MongoDB Atlas connection string (see README for setup steps)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/libraria?retryWrites=true&w=majority

# NextAuth
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
